---
// Google Play のフィーチャーグラフィック（1024 x 500）
import Bare from '../../layouts/Bare.astro';
import { BRAND, FEATURE, LANGS, type Lang } from '../../data/slides';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const b = BRAND[lang];
---

<Bare title={`feature ${lang}`}>
  <div class:list={['fg', lang]} style={`width:${FEATURE.w}px;height:${FEATURE.h}px`}>
    <div class="text">
      <div class="brand">
        <img src="/icon.png" alt="" />
        <div>
          <b>{b.name}</b>
          <span>{b.category}</span>
        </div>
      </div>
      <h1 set:html={b.feature.replace(/\n/g, '<br>')} />
      <div class="dots">
        {[1, 1, 1, 0, 1, 1, 1].map((on) => <i class:list={{ on: on === 1 }} />)}
      </div>
    </div>
    <img class="art" src="/rest.png" alt="" />
  </div>
</Bare>

<style>
  .fg {
    position: relative;
    overflow: hidden;
    color: #17241b;
    font-family: -apple-system, 'SF Pro Display', 'Hiragino Sans', sans-serif;
    background:
      radial-gradient(60% 90% at 85% 50%, #d3e6d7 0%, transparent 70%),
      #eef4ef;
  }
  .fg.ja {
    font-family: 'Hiragino Sans', 'Hiragino Kaku Gothic ProN', sans-serif;
  }
  .text {
    position: absolute;
    left: 72px;
    top: 50%;
    transform: translateY(-50%);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .brand img {
    width: 56px;
    height: 56px;
    border-radius: 13px;
  }
  .brand b {
    display: block;
    font-size: 24px;
    font-weight: 800;
  }
  .brand span {
    display: block;
    font-size: 15px;
    color: #4d5f52;
    font-weight: 600;
  }
  h1 {
    margin: 28px 0 0;
    font-size: 50px;
    line-height: 1.3;
    font-weight: 800;
  }
  .ja h1 {
    font-size: 46px;
    letter-spacing: 0.02em;
  }
  .dots {
    display: flex;
    gap: 10px;
    margin-top: 28px;
  }
  .dots i {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    border: 3.5px solid #4a7c59;
    box-sizing: border-box;
  }
  .dots .on {
    background: #4a7c59;
  }
  .art {
    position: absolute;
    right: 56px;
    top: 50%;
    transform: translateY(-50%);
    width: 380px;
  }
</style>
