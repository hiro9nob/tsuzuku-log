/* Siri とショートカットの文言（キーは Swift の英語の文字列） */
"Habit" = "습관";
"Log a habit" = "습관 기록";
"Logs a habit for today without opening the app." = "앱을 열지 않고 오늘의 습관을 기록해요.";
"Which habit?" = "어떤 습관을 기록할까요?";
"Couldn't log it. Please open the app." = "기록하지 못했어요. 앱을 열어 주세요.";
"Logged %@." = "%@ 기록했어요.";
"Today's progress" = "오늘의 진행 상황";
"Tells you how many of today's habits are done." = "오늘 습관을 몇 개 했는지 알려 줘요.";
"Open the app to add a habit." = "앱에서 습관을 추가해 주세요.";
"%lld of %lld done today." = "오늘 %lld / %lld 완료했어요.";
