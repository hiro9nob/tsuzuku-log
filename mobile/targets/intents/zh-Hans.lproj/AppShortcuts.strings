/* Siri に話しかける言い方（${applicationName} はアプリの名前、${habit} は習慣） */
"Log ${habit} in ${applicationName}" = "在${applicationName}记录${habit}";
"Log a habit in ${applicationName}" = "在${applicationName}记录习惯";
"Today's progress in ${applicationName}" = "${applicationName}今天的进度";
"How am I doing in ${applicationName}" = "${applicationName}今天完成了多少";
