{
  "name": "ongo",
  "main": "index.ts",
  "version": "1.0.0",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@formatjs/intl-pluralrules": "^6.3.15",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "drizzle-orm": "^0.45.3",
    "expo": "~57.0.26",
    "expo-constants": "~57.0.20",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.11",
    "expo-local-authentication": "~57.0.3",
    "expo-localization": "~57.0.2",
    "expo-notifications": "~57.0.23",
    "expo-router": "~57.0.24",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-store-review": "~57.0.3",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-task-manager": "~57.0.21",
    "i18next": "^26.4.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.15",
    "react-native": "0.86.3",
    "react-native-android-widget": "^0.22.1",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-purchases": "^10.11.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@bacons/apple-targets": "5.0.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "babel-plugin-inline-import": "^3.0.0",
    "babel-preset-expo": "~57.0.13",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.5",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "start:clear": "expo start --dev-client --clear",
    "ios": "expo run:ios",
    "ios:device": "expo run:ios --device",
    "ios:release": "expo run:ios --configuration Release",
    "ios:device:release": "expo run:ios --device --configuration Release",
    "build:ios:production": "pnpm dlx eas-cli@latest build --platform ios --profile production",
    "release:ios:production": "pnpm dlx eas-cli@latest submit --platform ios --profile production --latest",
    "android": "ANDROID_HOME=${ANDROID_HOME:-$HOME/Library/Android/sdk} expo run:android",
    "android:device": "ANDROID_HOME=${ANDROID_HOME:-$HOME/Library/Android/sdk} expo run:android --device",
    "android:release": "ANDROID_HOME=${ANDROID_HOME:-$HOME/Library/Android/sdk} expo run:android --variant release",
    "simulator:ios": "open -a Simulator",
    "emulator:android": "ANDROID_HOME=${ANDROID_HOME:-$HOME/Library/Android/sdk} sh -c \"\\$ANDROID_HOME/emulator/emulator -avd ${AVD:-Pixel_9} -netdelay none -netspeed full\"",
    "emulator:android:list": "ANDROID_HOME=${ANDROID_HOME:-$HOME/Library/Android/sdk} sh -c \"\\$ANDROID_HOME/emulator/emulator -list-avds\"",
    "prebuild": "expo prebuild --clean",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "doctor": "pnpm dlx expo-doctor",
    "store:check": "node --env-file=.env.local scripts/store/check.mjs",
    "store:asc:bundle": "node --env-file=.env.local scripts/store/asc-bundle.mjs",
    "store:asc:testflight": "node --env-file=.env.local scripts/store/asc-testflight.mjs",
    "store:asc:iap": "node --env-file=.env.local scripts/store/asc-iap.mjs",
    "store:asc:app": "node --env-file=.env.local scripts/store/asc-app.mjs",
    "store:asc:contact": "node --env-file=.env.local scripts/store/asc-contact.mjs",
    "store:asc:version": "node --env-file=.env.local scripts/store/asc-version.mjs",
    "store:asc:listing": "node --env-file=.env.local scripts/store/asc-listing.mjs",
    "store:asc:screenshots": "node --env-file=.env.local scripts/store/asc-screenshots.mjs",
    "store:asc:review": "node --env-file=.env.local scripts/store/asc-review.mjs",
    "store:rc": "node --env-file=.env.local scripts/store/rc-setup.mjs",
    "build:dev:ios": "pnpm dlx eas-cli@latest build --profile development --platform ios",
    "build:dev:android": "pnpm dlx eas-cli@latest build --profile development --platform android",
    "build:android:production": "pnpm dlx eas-cli@latest build --platform android --profile production",
    "release:android:production": "pnpm dlx eas-cli@latest submit --platform android --profile production --latest",
    "android:device:release": "ANDROID_HOME=${ANDROID_HOME:-$HOME/Library/Android/sdk} expo run:android --device --variant release"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.ts?(x)"
    ]
  },
  "packageManager": "pnpm@10.28.0"
}
